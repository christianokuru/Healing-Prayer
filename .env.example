# Copy to .env.local for local development.

# Serve /api/* from the in-memory mock (no backend needed).
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Google Search Console verification code (HTML tag method, content value only).
# GOOGLE_SITE_VERIFICATION=

# Real FastAPI backend instead of the mock: set NEXT_PUBLIC_USE_MOCK=false and these.
# API_PROXY_TARGET=http://localhost:8000
# API_INTERNAL_URL=http://localhost:8000

# Dev server only. Phones on 192.168.x.x / 10.x.x.x networks and *.local names are allowed
# already; add other hostnames (comma-separated) if your network uses a different range.
# DEV_ALLOWED_ORIGINS=172.20.10.2
